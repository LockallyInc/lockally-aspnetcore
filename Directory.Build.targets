<Project>
  <!--
    Lockally package metadata for every .NET project in the repo.

    A .targets file is imported AFTER the project file, so these values win over
    whatever the project sets. That matters for Lockally.SDK, whose csproj is
    regenerated by openapi-generator on every release and would otherwise carry
    the generator defaults ("OpenAPI" as author, "No Copyright"). It also gives
    both packages the logo on nuget.org, which previously showed its generic icon.

    Copied into the repo root by sdk/publish-sdk-repos.sh; edit it there.
  -->
  <PropertyGroup>
    <Authors>Lockally</Authors>
    <Company>Lockally</Company>
    <Copyright>Copyright (c) Lockally</Copyright>
    <PackageProjectUrl>https://lockally.com</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
